<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:vm="clr-namespace:GIPractice.Wpf.ViewModels">

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Small, uniform icon buttons for toolbars (prevents DockPanel "last child fills" surprises) -->
    <Style x:Key="ToolbarIconButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- Trimming helper for DataGrid text columns -->
    <Style x:Key="DataGridTrimText" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <DataTemplate DataType="{x:Type vm:PatientsPageViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Search panel column: Auto so Collapsed search doesn't keep empty space -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- LEFT: SEARCH PANEL -->
			    <Border Grid.Column="0" Width="420"
			            Background="{DynamicResource MahApps.Brushes.Gray10}"
			            BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
			            BorderThickness="0,0,1,0"
			            Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVis}}">

			        <Grid Margin="10">
			            <Grid.RowDefinitions>
			                <RowDefinition Height="Auto"/>
			                <RowDefinition Height="Auto"/>
			                <RowDefinition Height="*"/>
			                <RowDefinition Height="Auto"/>
			            </Grid.RowDefinitions>

			            <!-- Header + close -->
			            <DockPanel Grid.Row="0" LastChildFill="False">
			                <TextBlock FontWeight="Bold" FontSize="16"
			                           VerticalAlignment="Center"
			                           Text="ΑΝΑΖΗΤΗΣΗ ΑΣΘΕΝΟΥΣ"/>
			                <Button DockPanel.Dock="Right" Padding="8,4"
			                        Command="{Binding ToggleSearchCommand}">
			                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16">&#xE711;</TextBlock>
			                </Button>
			            </DockPanel>

			            <!-- Criteria -->
                    <ScrollViewer Grid.Row="1" Margin="0,10,0,10"
			                          VerticalScrollBarVisibility="Auto"
			                          HorizontalScrollBarVisibility="Disabled">
			                <StackPanel>
			                    <TextBox Margin="0,0,0,6" mah:TextBoxHelper.Watermark="Όνομα"
			                             Text="{Binding SearchFirstName, UpdateSourceTrigger=PropertyChanged}"/>
			                    <TextBox Margin="0,0,0,6" mah:TextBoxHelper.Watermark="Επίθετο"
			                             Text="{Binding SearchLastName, UpdateSourceTrigger=PropertyChanged}"/>
			                    <TextBox Margin="0,0,0,6" mah:TextBoxHelper.Watermark="Πατρώνυμο"
			                             Text="{Binding SearchFathersName, UpdateSourceTrigger=PropertyChanged}"/>
			                    <TextBox Margin="0,0,0,6" mah:TextBoxHelper.Watermark="ΠΑ"
			                             Text="{Binding SearchPersonalNumber, UpdateSourceTrigger=PropertyChanged}"/>
			                    <TextBox Margin="0,0,0,6" mah:TextBoxHelper.Watermark="Τηλέφωνο"
			                             Text="{Binding SearchPhone, UpdateSourceTrigger=PropertyChanged}"/>
			                    <TextBox Margin="0,0,0,10" mah:TextBoxHelper.Watermark="Email"
			                             Text="{Binding SearchEmail, UpdateSourceTrigger=PropertyChanged}"/>

			                    <Expander Header="Φίλτρα" IsExpanded="False">
			                        <StackPanel Margin="0,6,0,0">
			                            <CheckBox Content="Ιστορικό CA" IsChecked="{Binding SearchHasHadCA}"/>
			                            <CheckBox Content="Ιστορικό IBD" IsChecked="{Binding SearchHasHadIBD}"/>
			                            <CheckBox Content="Έχει εκκρεμείς βιοψίες" IsChecked="{Binding SearchHasPendingBiopsies}"/>
			                            <CheckBox Content="Έχει προγραμματισμένη ενδοσκόπηση" IsChecked="{Binding SearchHasScheduledEndo}"/>
			                        </StackPanel>
			                    </Expander>

			                    <UniformGrid Columns="2" Margin="0,10,0,0">
			                        <Button Content="ΑΝΑΖΗΤΗΣΗ" Margin="0,0,6,0"
			                                Command="{Binding PerformSearchCommand}"/>
			                        <Button Content="ΚΑΘΑΡΙΣΜΑ" Margin="6,0,0,0"
			                                Command="{Binding ClearSearchCommand}"/>
			                    </UniformGrid>
			                </StackPanel>
			            </ScrollViewer>

			            <!-- Results -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding SearchResults}"
			                     SelectedItem="{Binding SearchSelectedPatient, Mode=TwoWay}">
			                <ListBox.ItemTemplate>
			                    <DataTemplate>
			                        <StackPanel Margin="4">
                                    <TextBlock FontWeight="SemiBold">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource PatientHeaderLineConverter}">
                                                <Binding Path="LastName"/>
                                                <Binding Path="FirstName"/>
                                                <Binding Path="FathersName"/>
                                                <Binding Path="BirthDate"/>
                                                <Binding Path="PersonalNumber"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Opacity="0.75" Text="{Binding PhoneNumber}"/>
			                        </StackPanel>
			                    </DataTemplate>
			                </ListBox.ItemTemplate>
			            </ListBox>

			            <Button Grid.Row="3" Margin="0,10,0,0"
			                    Content="ΕΠΙΛΟΓΗ"
			                    Command="{Binding SelectSearchPatientCommand}"/>
			        </Grid>
			    </Border>

            <!-- RIGHT: MAIN CONTENT -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <WrapPanel Margin="5" Orientation="Horizontal">

                    <!-- Patient details section (same bindings as before) -->
                    <StackPanel Width="Auto">
                        <GroupBox Margin="0,0,20,0" Header="ΣΤΟΙΧΕΙΑ ΑΣΘΕΝΟΥΣ">
                            <StackPanel Orientation="Horizontal">

                                <!-- Form -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Toolbar -->
                                    <StackPanel Margin="0,0,0,8" Grid.Row="0" Grid.Column="0" Grid.RowSpan="7">
                                        <Button Style="{StaticResource ToolbarIconButton}"
                                            ToolTip="ΑΝΑΖΗΤΗΣΗ ΑΣΘΕΝΟΥΣ"
                                            Command="{Binding ToggleSearchCommand}">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="24">&#xE721;</TextBlock>
                                        </Button>

                                        <Button Style="{StaticResource ToolbarIconButton}"
			                                ToolTip="ΝΕΟΣ ΑΣΘΕΝΗΣ"
			                                Command="{Binding NewPatientCommand}">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="24">&#xE8FA;</TextBlock>
                                        </Button>

                                        <Button Style="{StaticResource ToolbarIconButton}"
			                                ToolTip="ΕΝΗΜΕΡΩΣΗ ΑΣΘΕΝΟΥΣ"
			                                Command="{Binding SavePatientCommand}">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="24">&#xE74E;</TextBlock>
                                        </Button>

                                        <Button Style="{StaticResource ToolbarIconButton}"
			                                ToolTip="ΔΙΑΓΡΑΦΗ ΑΣΘΕΝΟΥΣ"
			                                Background="Red" Foreground="Yellow"
			                                Command="{Binding DeletePatientCommand}">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="24">&#xE74D;</TextBlock>
                                        </Button>
                                    </StackPanel>
                                    <Label Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">Σ/Α</Label>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,10,0,10" VerticalAlignment="Center"
                                            Text="{Binding SelectedPatient.Id}"/>

                                    <Label Grid.Row="1" Grid.Column="1">Όνομα</Label>
                                    <TextBox Grid.Row="1" Grid.Column="2" Margin="0,2.5"
                                            Text="{Binding SelectedPatient.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Label Grid.Row="2" Grid.Column="1">Επίθετο</Label>
                                    <TextBox Grid.Row="2" Grid.Column="2" Margin="0,2.5"
                                            Text="{Binding SelectedPatient.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Label Grid.Row="3" Grid.Column="1">Πατρώνυμο</Label>
                                    <TextBox Grid.Row="3" Grid.Column="2" Margin="0,2.5"
                                            Text="{Binding SelectedPatient.FathersName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Label Grid.Row="4" Grid.Column="1">ΠΑ</Label>
                                    <TextBox Grid.Row="4" Grid.Column="2" Margin="0,2.5"
                                            Text="{Binding SelectedPatient.PersonalNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Label Grid.Row="5" Grid.Column="1">Ημ. Γεννήσεως</Label>
                                    <mah:DateTimePicker Grid.Row="5" Grid.Column="2" Margin="0,2.5"
                                                    SelectedDateTime="{Binding SelectedPatient.BirthDate, Mode=TwoWay}"
                                                    mah:TextBoxHelper.Watermark="Επιλογή Ημερομηνίας"/>

                                    <Label Grid.Row="6" Grid.Column="1">Φύλο</Label>
                                    <ComboBox Grid.Row="6" Grid.Column="2" Margin="0,2.5"
                                            ItemsSource="{Binding GenderOptions}"
                                            SelectedItem="{Binding SelectedPatient.Gender, Mode=TwoWay}"/>

                                    <Label Grid.Row="7" Grid.Column="0">Email</Label>
                                    <TextBox Grid.Row="7" Grid.Column="1" Margin="0,2.5" Grid.ColumnSpan="2"
                                            Text="{Binding SelectedPatient.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Label Grid.Row="8" Grid.Column="0">Τηλέφωνο</Label>
                                    <TextBox Grid.Row="8" Grid.Column="1" Margin="0,2.5" Grid.ColumnSpan="2"
                                            Text="{Binding SelectedPatient.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Label Grid.Row="9" Grid.Column="0">Διεύθυνση</Label>
                                    <TextBox Grid.Row="9" Grid.Column="1" Margin="0,2.5" Grid.ColumnSpan="2"
                                            Text="{Binding SelectedPatient.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- Photo -->
                                <Grid Margin="20,0,15,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="300"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Width="300" Height="300" Background="Black">
                                        <Image Source="{Binding SelectedPatient.PhotoImageSource}" Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                                        <Button Margin="5" ToolTip="ΛΗΨΗ ΝΕΑΣ ΦΩΤΟΓΡΑΦΙΑΣ"
                                            Command="{Binding CapturePhotoCommand}">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="24">&#xE722;</TextBlock>
                                        </Button>

                                        <Button Margin="5" ToolTip="ΑΠΟ ΑΡΧΕΙΟ..."
                                            Command="{Binding PhotoFromFileCommand}">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="24">&#xEC50;</TextBlock>
                                        </Button>

                                        <!-- ΕΠΑΝΑΦΟΡΑ = reset photo baseline -->
                                        <Button Margin="5" ToolTip="ΕΠΑΝΑΦΟΡΑ"
                                            Command="{Binding RefreshPatientCommand}">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="24">&#xE777;</TextBlock>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Side grids (bind to dummy collections) -->
                                <StackPanel Width="410">
                                    <GroupBox Margin="0,10,20,0" Header="ΒΙΟΨΙΕΣ ΠΟΥ ΔΕΝ ΕΧΟΥΝ ΣΤΑΛΘΕΙ">
                                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True"
                                                CanUserAddRows="False" CanUserDeleteRows="False"
                                                ItemsSource="{Binding PendingBiopsies}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ΗΜ/ΩΡΑ" Binding="{Binding EndoscopyDateTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="*"/>
                                                <DataGridCheckBoxColumn Header="ΕΠΕΙΓΟΝ" Binding="{Binding IsUrgent}" Width="0.415*"/>
                                                <DataGridTextColumn Header="ΑΡ" Binding="{Binding HowManyBiopsyBottles}" Width="0.545*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </GroupBox>

                                    <GroupBox Margin="0,10,20,0" Header="ΠΑΘΟΛΟΓ/ΚΕΣ ΠΟΥ ΔΕΝ ΕΧΟΥΝ ΒΓΕΙ ΑΚΟΜΗ">
                                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True"
                                                CanUserAddRows="False" CanUserDeleteRows="False"
                                                ItemsSource="{Binding PendingPathologyReports}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ΗΜ/ΩΡΑ" Binding="{Binding EndoscopyDateTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="*"/>
                                                <DataGridCheckBoxColumn Header="ΕΠΕΙΓΟΝ" Binding="{Binding IsUrgent}" Width="0.415*"/>
                                                <DataGridTextColumn Header="ΑΡ" Binding="{Binding HowManyBiopsyBottles}" Width="0.545*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </GroupBox>

                                    <GroupBox Margin="0,10,20,0" Header="ΠΡΟΣΕΧΗ ΡΑΝΤΕΒΟΥ">
                                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True"
							                        CanUserAddRows="False" CanUserDeleteRows="False"
							                        ItemsSource="{Binding PendingAppointments}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ΗΜΕΡΟΜΗΝΙΑ" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Width="*"/>
                                                <DataGridTextColumn Header="ΩΡΑ" Binding="{Binding Date, StringFormat={}{0:HH:mm}}" Width="0.5*"/>
                                                <DataGridCheckBoxColumn Header="ΕΠΕΙΓΟΝ" Binding="{Binding IsUrgent}" Width="Auto"/>
                                                <DataGridTextColumn Header="ΤΥΠΟΣ" Binding="{Binding AppointmentTypeName}" Width="*">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTrimText}">
                                                            <Setter Property="ToolTip" Value="{Binding AppointmentTypeName}"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </GroupBox>
                                </StackPanel>

                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- Patient appointments section with NewAppointmentCommand -->
                    <StackPanel Width="Auto">
                        <StackPanel Orientation="Horizontal">
                            <GroupBox Margin="0,10,20,0" Header="ΡΑΝΤΕΒΟΥ ΑΣΘΕΝΟΥΣ">
                                <StackPanel Width="Auto">
                                    <DataGrid AutoGenerateColumns="False" IsReadOnly="True"
							                        CanUserAddRows="False" CanUserDeleteRows="False"
							                        ItemsSource="{Binding PatientAppointments}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ΗΜΕΡΟΜΗΝΙΑ" Binding="{Binding Start, StringFormat={}{0:dd/MM/yyyy}}" Width="Auto"/>
                                            <DataGridTextColumn Header="ΩΡΑ" Binding="{Binding Start, StringFormat={}{0:HH:mm}}" Width="Auto"/>
                                            <DataGridTextColumn Header="ΣΚΟΠΟΣ" Binding="{Binding AppointmentTypeName}" Width="Auto" MinWidth="200">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTrimText}">
                                                        <Setter Property="ToolTip" Value="{Binding AppointmentTypeName}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Edit/Delete icons on each row -->
                                            <DataGridTemplateColumn Width="80" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Padding="6" Margin="0,0,6,0" ToolTip="Επεξεργασία"
							                                            Command="{Binding DataContext.EditPatientAppointmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
							                                            CommandParameter="{Binding}">
                                                                <iconPacks:PackIconMaterial Kind="Pencil" Width="18" Height="18"/>
                                                            </Button>
                                                            <Button Padding="6" ToolTip="Διαγραφή"
							                                            Command="{Binding DataContext.DeletePatientAppointmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
							                                            CommandParameter="{Binding}">
                                                                <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="18" Height="18"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Button Style="{StaticResource ToolbarIconButton}" ToolTip="ΝΕΟ ΡΑΝΤΕΒΟΥ"
							                    Command="{Binding NewAppointmentCommand}">
                                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="24">&#xE710;</TextBlock>
                                    </Button>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Margin="0,10,20,0" Header="ΙΣΤΟΡΙΚΟ ΑΣΘΕΝΟΥΣ">
                                <StackPanel Width="Auto">
                                    <DataGrid AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              ItemsSource="{Binding PatientHistoryEncounters}"
                                              SelectedItem="{Binding SelectedHistoryEncounter, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="50" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Padding="6" ToolTip="Άνοιγμα"
                                                                Command="{Binding DataContext.OpenEncounterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}">
                                                            <iconPacks:PackIconMaterial Kind="OpenInNew" Width="18" Height="18"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="ΗΜΕΡΟΜΗΝΙΑ" Binding="{Binding Start, StringFormat={}{0:dd/MM/yyyy}}" Width="Auto"/>
                                            <DataGridTextColumn Header="ΕΝΑΡΞΗ" Binding="{Binding Start, StringFormat={}{0:HH:mm}}" Width="Auto"/>
                                            <DataGridTextColumn Header="ΤΥΠΟΣ" Binding="{Binding DisplayType}" Width="Auto" MinWidth="150">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTrimText}">
                                                        <Setter Property="ToolTip" Value="{Binding DisplayType}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="ΔΙΑΡΚΕΙΑ" Binding="{Binding DurationMinutes}" Width="Auto"/>
                                            <DataGridTextColumn Header="ΣΗΜΕΙΩΣΕΙΣ" Binding="{Binding Notes}" Width="Auto" MinWidth="240">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTrimText}">
                                                        <Setter Property="ToolTip" Value="{Binding Notes}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>

                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </ScrollViewer>

            <!-- SCHEDULER OVERLAY (reuses your existing NewAppointmentDayTemplate) -->
            <Border Grid.ColumnSpan="2"
                    Background="#80000000"
                    Visibility="{Binding IsSchedulerOpen, Converter={StaticResource BoolToVis}}">
                <Border Width="1200" Height="850"
                        Background="{DynamicResource MahApps.Brushes.Button.Flat.Background}"
                        BorderBrush="{DynamicResource MahApps.Brushes.Button.Flat.Background}"
                        BorderThickness="2"
                        Padding="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <DockPanel Background="{DynamicResource MahApps.Brushes.Button.Flat.Background}">
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                            <TextBlock FontWeight="Bold" FontSize="16"
                                       VerticalAlignment="Center"
                                       Text="ΝΕΟ ΡΑΝΤΕΒΟΥ"/>
                            <Button DockPanel.Dock="Right" Padding="8,4"
                                    Command="{Binding CloseSchedulerCommand}">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16">&#xE711;</TextBlock>
                            </Button>
                        </DockPanel>

                        <!-- This content will be rendered by NewAppointmentDayTemplate.xaml -->
                        <ContentControl Content="{Binding AppointmentScheduler}" />
                    </DockPanel>
                </Border>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
