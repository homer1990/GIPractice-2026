<UserControl x:Class="GIPractice.Wpf.Views.PatientSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GIPractice.Wpf.Views"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="3"
                    Grid.Column="1"
                    Grid.ColumnSpan="5"
                    Height="5"
                    Background="{DynamicResource MahApps.Brushes.Accent}"/>
                <Border
                    Grid.Row="7"
                    Grid.Column="1"
                    Grid.ColumnSpan="5"
                    Height="5"
                    Background="{DynamicResource MahApps.Brushes.Accent}"/>
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.RowSpan="7"
                    Width="5"
                    Background="{DynamicResource MahApps.Brushes.Accent}"/>
                <Border
                    Grid.Row="0"
                    Grid.Column="6"
                    Grid.RowSpan="7"
                    Width="5"
                    Background="{DynamicResource MahApps.Brushes.Accent}"/>
                <DockPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="5"
                    Background="{DynamicResource MahApps.Brushes.Accent}"
                    FlowDirection="LeftToRight">
                    <TextBlock
                        FontSize="{DynamicResource MahApps.Font.Size.Header}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                        Text="ΕΠΙΛΟΓΗ ΑΣΘΕΝΟΥΣ"
                        Margin="10,10,10,10"/>
                </DockPanel>
                <Label
                    FontSize="18"
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="Όνομα"/>
                <Label
                    FontSize="18"
                    Grid.Row="1"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="Επίθετο"/>
                <Label
                    FontSize="18"
                    Grid.Row="1"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Content="Πατρώνυμο"/>
                <Label
                    FontSize="18"
                    Grid.Row="1"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Content="Ημερομηνία Γενν."/>
                <Label
                    FontSize="12"
                    Grid.Row="4"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="Τελευταία Επίσκεψη από:"/>
                <Label
                    FontSize="12"
                    Grid.Row="4"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="Τελευταία Επίσκεψη έως:"/>
                <Label
                    FontSize="12"
                    Grid.Row="4"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Content="Τελευταία Ενδοσκόπηση από:"/>
                <Label
                    FontSize="12"
                    Grid.Row="4"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Content="Τελευταία Ενδοσκόπηση έως:"/>
                <Label
                    FontSize="14"
                    Grid.Row="1"
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Content="Προσωπικός Αριθμός"/>
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Name="FirstName"
                    Margin="5"/>
                <TextBox
                    Grid.Row="2"
                    Grid.Column="2"
                    Name="LastName"
                    Margin="5"/>
                <mah:DateTimePicker
                    Grid.Row="2"
                    Grid.Column="4"
                    Name="Birthdate"
                    Margin="5">
                    <mah:TextBoxHelper.Watermark>
                        ΕΠΙΛΟΓΗ ΗΜΕΡΟΜΗΝΙΑΣ
                    </mah:TextBoxHelper.Watermark>
                </mah:DateTimePicker>
                <TextBox
                    Grid.Row="2"
                    Grid.Column="3"
                    Name="FatherName"
                    Margin="5"/>
                <TextBox
                    Grid.Row="2"
                    Grid.Column="5"
                    Name="PersonalNumber"
                    Margin="5"/>
                <mah:DateTimePicker
                    Grid.Row="5"
                    Grid.Column="1"
                    Name="LastVisitFrom"
                    Margin="5">
                    <mah:TextBoxHelper.Watermark>
                        ΕΠΙΛΟΓΗ ΗΜΕΡΟΜΗΝΙΑΣ
                    </mah:TextBoxHelper.Watermark>
                </mah:DateTimePicker>
                <mah:DateTimePicker
                    Grid.Row="5"
                    Grid.Column="2"
                    Name="LastVisitTo"
                    Margin="5">
                    <mah:TextBoxHelper.Watermark>
                        ΕΠΙΛΟΓΗ ΗΜΕΡΟΜΗΝΙΑΣ
                    </mah:TextBoxHelper.Watermark>
                </mah:DateTimePicker>
                <mah:DateTimePicker
                    Grid.Row="5"
                    Grid.Column="3"
                    Name="LastEndoFrom"
                    Margin="5">
                    <mah:TextBoxHelper.Watermark>
                        ΕΠΙΛΟΓΗ ΗΜΕΡΟΜΗΝΙΑΣ
                    </mah:TextBoxHelper.Watermark>
                </mah:DateTimePicker>
                <mah:DateTimePicker
                    Grid.Row="5"
                    Grid.Column="4"
                    Name="LastEndoTo"
                    Margin="5">
                    <mah:TextBoxHelper.Watermark>
                        ΕΠΙΛΟΓΗ ΗΜΕΡΟΜΗΝΙΑΣ
                    </mah:TextBoxHelper.Watermark>
                </mah:DateTimePicker>
                <Button
                    x:Name="SearchButton"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Grid.Column="5"
                    Grid.Row="4"
                    Grid.RowSpan="2"
                    Margin="5,0,5,0"
                    Padding="10">
                    <StackPanel 
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                        <TextBlock 
                            FontFamily="Segoe Fluent Icons"
                            Text="&#xE721;"
                            FontSize="20"
                            VerticalAlignment="Center"/>
                        <TextBlock 
                            Text="ΑΝΑΖΗΤΗΣΗ"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <DataGrid
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="7"
                Margin="0"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                IsReadOnly="True"
                Name="PatientsDataGrid"
                HorizontalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ΠΡ. ΑΡΙΘΜΟΣ" Binding="{Binding PersonalNumber}" Width="0.75*"/>
                    <DataGridTextColumn Header="ΟΝΟΜΑ" Binding="{Binding FirstName}" Width="*"/>
                    <DataGridTextColumn Header="ΕΠΙΘΕΤΟ" Binding="{Binding LastName}" Width="*"/>
                    <DataGridTextColumn Header="ΠΑΤΡΩΝΥΜΟ" Binding="{Binding FatherName}" Width="*"/>
                    <DataGridTextColumn Header="Η/Μ ΓΕΝΝΗΣΕΩΣ" Binding="{Binding Birthdate, StringFormat=d}" Width="0.9*"/>
                    <DataGridTextColumn Header="ΤΕΛΕΥΤΑΙΑ ΕΠΙΣΚΕΨΗ" Binding="{Binding LastVisitDate, StringFormat=d}" Width="1.15*"/>
                    <DataGridTextColumn Header="ΤΕΛΕΥΤΑΙΑ ΕΝΔΟ." Binding="{Binding LastEndoscopyDate, StringFormat=d}" Width="1*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
