<mah:MetroWindow
    x:Class="GIPractice.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:local="clr-namespace:GIPractice.Wpf"
    xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
    Dialog:DialogParticipation.Register="{Binding}"
    Title="GIPractice"
    Height="600"
    TitleBarHeight="32"
    Width="0"
    x:Name="ShellWindow">
    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl
            Margin="{Binding ElementName=ShellWindow,
                             Path=TitleBarHeight,
                             Converter={StaticResource TopThicknessConverter}}">
            <mah:Flyout Header="{Binding Flyout.Header}"
                        IsOpen="{Binding Flyout.IsOpen, Mode=TwoWay}"
                        Position="{Binding Flyout.Position}"
                        Width="{Binding Flyout.Width}"
                        IsModal="{Binding Flyout.IsModal}"
                        Theme="Adapt"
                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">
                <ContentControl Content="{Binding Flyout.Content}"/>
            </mah:Flyout>
        </mah:FlyoutsControl>
    </mah:MetroWindow.Flyouts>
    <Frame x:Name="Root">
    </Frame>
</mah:MetroWindow>