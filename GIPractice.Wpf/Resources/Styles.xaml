<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">

    <!-- Global sizes used by MahApps templates -->
    <sys:Double x:Key="MahApps.Font.Size.Default">18</sys:Double>
    <sys:Double x:Key="MahApps.Font.Size.Content">16</sys:Double>
    <sys:Double x:Key="MahApps.Font.Size.Header">30</sys:Double>
    <sys:Double x:Key="MahApps.Font.Size.SubHeader">25</sys:Double>
    <sys:Double x:Key="MahApps.Font.Size.Button">15</sys:Double>
    <sys:Double x:Key="MahApps.Font.Size.Window.Title">20</sys:Double>
    <!-- Template for HamburgerMenuGlyphItem -->
    <DataTemplate x:Key="NavGlyphItemTemplate"
                DataType="{x:Type mah:HamburgerMenuGlyphItem}">
        <Grid Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                    Text="{Binding Glyph}"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="32"
                    FontWeight="Light"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                    Text="{Binding Label}"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0"
                    FontSize="20"/>
        </Grid>
    </DataTemplate>

    <!-- Apply it to HamburgerMenu (either keyed or global) -->
    <Style x:Key="GiPracticeHamburgerMenuStyle" TargetType="{x:Type mah:HamburgerMenu}">
        <Setter Property="ItemTemplate" Value="{StaticResource NavGlyphItemTemplate}" />
        <Setter Property="OptionsItemTemplate" Value="{StaticResource NavGlyphItemTemplate}" />
    </Style>
</ResourceDictionary>