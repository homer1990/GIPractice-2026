+using System.Reflection;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace GIPractice.Api.Tests;
+
+/// <summary>
+/// JSON options for tests.
+///
+/// The API serializes strong ID record-structs (e.g. PatientId, AppointmentId)
+/// as JSON numbers (e.g. 123). Default System.Text.Json can't deserialize those
+/// into custom structs without a converter, so tests should use <see cref="Options" />.
+/// </summary>
+public static class TestJson
+{
+    public static readonly JsonSerializerOptions Options = Create();
+
+    private static JsonSerializerOptions Create()
+    {
+        var opt = new JsonSerializerOptions(JsonSerializerDefaults.Web);
+        opt.Converters.Add(new StrongIntIdJsonConverterFactory());
+        return opt;
+    }
+}
+
+/// <summary>
+/// JsonConverterFactory that targets record-struct IDs with:
+/// - a public int Value property, and
+/// - a public ctor(int)
+///
+/// It supports both numeric form: 123
+/// and object form: { "value": 123 }.
+/// </summary>
+public sealed class StrongIntIdJsonConverterFactory : JsonConverterFactory
+{
+    public override bool CanConvert(Type typeToConvert)
+    {
+        if (!typeToConvert.IsValueType)
+            return false;
+
+        var valueProp = typeToConvert.GetProperty("Value", BindingFlags.Instance | BindingFlags.Public);
+        if (valueProp is null || valueProp.PropertyType != typeof(int))
+            return false;
+
+        return typeToConvert.GetConstructor(new[] { typeof(int) }) is not null;
+    }
+
+    public override JsonConverter CreateConverter(Type typeToConvert, JsonSerializerOptions options)
+    {
+        var converterType = typeof(StrongIntIdJsonConverter<>).MakeGenericType(typeToConvert);
+        return (JsonConverter)Activator.CreateInstance(converterType)!;
+    }
+}
+
+public sealed class StrongIntIdJsonConverter<T> : JsonConverter<T> where T : struct
+{
+    private static readonly ConstructorInfo Ctor = typeof(T).GetConstructor(new[] { typeof(int) })
+        ?? throw new InvalidOperationException($"{typeof(T).Name} must have a ctor(int).");
+
+    private static readonly PropertyInfo ValueProp = typeof(T).GetProperty("Value", BindingFlags.Instance | BindingFlags.Public)
+        ?? throw new InvalidOperationException($"{typeof(T).Name} must have a Value property.");
+
+    public override T Read(ref Utf8JsonReader reader, Type typeToConvert, JsonSerializerOptions options)
+    {
+        // Numeric form: 123
+        if (reader.TokenType == JsonTokenType.Number)
+        {
+            var v = reader.GetInt32();
+            return (T)Ctor.Invoke(new object[] { v });
+        }
+
+        // Object form: { "value": 123 }
+        if (reader.TokenType == JsonTokenType.StartObject)
+        {
+            using var doc = JsonDocument.ParseValue(ref reader);
+            var root = doc.RootElement;
+
+            if (root.TryGetProperty("value", out var ve) || root.TryGetProperty("Value", out ve))
+            {
+                var v = ve.GetInt32();
+                return (T)Ctor.Invoke(new object[] { v });
+            }
+        }
+
+        throw new JsonException($"Cannot deserialize {typeof(T).Name} from JSON token {reader.TokenType}.");
+    }
+
+    public override void Write(Utf8JsonWriter writer, T value, JsonSerializerOptions options)
+    {
+        var v = (int)(ValueProp.GetValue(value) ?? 0);
+        writer.WriteNumberValue(v);
+    }
+}
